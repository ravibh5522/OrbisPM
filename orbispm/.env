# ============================================================
# OrbisPM — Unified Environment Configuration
# ============================================================
# All services read from this single file.
# Docker Compose auto-loads .env from the project root.
# ============================================================

# ── Compose ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=orbispm

# ── Application ──────────────────────────────────────────────
APP_ENV=development
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# ── PostgreSQL (external) ────────────────────────────────────
POSTGRES_HOST=35.207.238.251
POSTGRES_PORT=9000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YESVeW48YWdzHq3DYlJRG80DjMgIE
POSTGRES_DB=postgres
POSTGRES_SSL_MODE=disable

# ── Redis (external) ────────────────────────────────────────
REDIS_HOST=35.207.238.251
REDIS_PORT=9001
REDIS_PASSWORD=RuIyoaVBvoSOBajVCGCrUtHH8Md9amLeMY1e1eT
REDIS_USERNAME=default

# ── Zitadel (Identity Provider) ─────────────────────────────
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_MAPPED_PORT=8081
ZITADEL_EXTERNAL_DOMAIN=zitadel.animastuff.fun
