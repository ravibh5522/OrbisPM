# ── Mailpit (Development SMTP) ──────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@orbispm.local
SMTP_ENABLED=true
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── API Backend ──────────────────────────────────────────────
API_PORT=8080
API_REPLICAS=1
JWT_SECRET=orbispm-dev-jwt-secret-32chars!!
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=50

# ── Kong API Gateway ────────────────────────────────────────
KONG_PROXY_PORT=8000
KONG_SSL_PORT=8443
KONG_LOG_LEVEL=info

# ── NocoDB ───────────────────────────────────────────────────
NOCODB_PORT=8082

# ── Stripe (optional) ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
