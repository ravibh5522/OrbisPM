# ============================================================
# OrbisPM — LOCAL DEVELOPMENT Environment
# ============================================================
# This file is for LOCAL DEVELOPMENT only.
# It points to a local Docker postgres and redis.
# NEVER commit this file to git.
#
# For production: copy .env.example to .env.production
# and fill in your production values.
# ============================================================

# ── Compose ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=orbispm

# ── Application ──────────────────────────────────────────────
APP_ENV=development
ENV=development
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL (LOCAL — docker container) ────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YESVeW48YWdzHq3DYlJRG80DjMgIE
POSTGRES_DB=orbispmdev
POSTGRES_SSL_MODE=disable
DATABASE_URL=postgres://postgres:YESVeW48YWdzHq3DYlJRG80DjMgIE@localhost:5432/orbispmdev?sslmode=disable
# ↑ Local dev DB (Docker container orbispm-postgres-1)

# ── Redis (LOCAL — docker container, no password) ────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_URL=redis://localhost:6379/0

# ── Zitadel (LOCAL — docker container at localhost:8081) ─────
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_MAPPED_PORT=8081
ZITADEL_EXTERNAL_DOMAIN=localhost
ZITADEL_EXTERNAL_SECURE=false
ZITADEL_EXTERNAL_PORT=8081
ZITADEL_ADMIN_USER=admin@orbispm.local
ZITADEL_ADMIN_PASSWORD=Admin123!
ZITADEL_ORG_NAME=OrbisPM
ZITADEL_INSTANCE_NAME=OrbisPM
ZITADEL_MACHINE_USERNAME=backend-service
ZITADEL_MACHINE_NAME=OrbisPM Backend
ZITADEL_MACHINE_PAT_EXPIRY=2030-01-01T00:00:00Z
ZITADEL_LOG_LEVEL=info
ZITADEL_VERSION=v4.12.1
ZITADEL_SERVICE_TOKEN=0Ck8BCKaVT6jZDIWfC4S_7ba4BFJt8CORcKZ5A0jg1_Kvdb80Pu9KNVrAiXQMO99LZVzmtA
ZITADEL_CLIENT_ID=366339366072680452

# ── MinIO (LOCAL — docker container) ─────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=orbispm
MINIO_USE_SSL=false
MINIO_SERVER_URL=http://localhost:9000
MINIO_CONSOLE_URL=http://localhost:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# ── Meilisearch ──────────────────────────────────────────────
MEILI_HOST=meilisearch
MEILI_MASTER_KEY=masterkey-for-dev-only
MEILI_PORT=7700

# ── Mailpit (Dev SMTP) ───────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@orbispm.local
SMTP_ENABLED=true
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── API Backend ───────────────────────────────────────────────
API_PORT=8080
API_REPLICAS=1
JWT_SECRET=orbispm-dev-jwt-secret-32chars!!
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=50

# ── Kong API Gateway ─────────────────────────────────────────
KONG_PROXY_PORT=8000
KONG_SSL_PORT=8443
KONG_LOG_LEVEL=info

# ── NocoDB ────────────────────────────────────────────────────
NOCODB_PORT=8082

# ── Stripe (disabled in dev) ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false
EMAIL_REDIS_URL=redis://redis:6379/1

# ── Docker-internal URLs (for compose services) ────────────
ZITADEL_ISSUER=http://localhost:8081
ZITADEL_INTERNAL_URL=http://zitadel:8080
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_PUBLIC_URL=http://localhost:9000
ZITADEL_DOMAIN=localhost
NOCODB_DB_URL=postgres://postgres:YESVeW48YWdzHq3DYlJRG80DjMgIE@postgres:5432/orbispmdev?sslmode=disable
EMAIL_REDIS_URL=redis://redis:6379/1
