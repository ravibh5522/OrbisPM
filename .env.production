# ============================================================
# OrbisPM — PRODUCTION
# ============================================================
# Usage: docker compose --env-file .env.production up -d
# Or:    make up-prod
#
# Fill in all YOUR_* placeholders before deploying.
# NEVER commit this file — it is in .gitignore.
# ============================================================

COMPOSE_PROJECT_NAME=orbispm

# ── Application ───────────────────────────────────────────────
APP_ENV=production
ENV=production
APP_NAME=OrbisPM
BASE_URL=https://api.orbispm.in
FRONTEND_URL=https://orbispm.live
FRONTEND_PORT=3000
ALLOWED_ORIGINS=https://www.orbispm.in,https://orbispm.in,https://orbispm.live,https://www.orbispm.live

# ── PostgreSQL (local direct) ─────────────────────────────────
POSTGRES_HOST=192.168.1.23
POSTGRES_PORT=5432
POSTGRES_USER=ravi_admin
POSTGRES_PASSWORD=Suraj5522
POSTGRES_DB=orbispmdev
DATABASE_URL=postgres://ravi_admin:Suraj5522@192.168.1.23:5432/orbispmdev?sslmode=disable

# ── Redis (local Docker) ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0
EMAIL_REDIS_URL=redis://redis:6379/1
# ── Zitadel (local with tunnel) ──────────────────────────────────────────
ZITADEL_DOMAIN=zitadel.orbispm.in
ZITADEL_ISSUER=https://zitadel.orbispm.in
ZITADEL_INTERNAL_URL=https://zitadel.orbispm.in
ZITADEL_SERVICE_TOKEN=CNHZW7FHGU-VA1DphdxaF1eS5tfdkHc7EI_FxziZmIlwi1FVFS8PRp9OMTchtPRt2AojMXg
ZITADEL_CLIENT_ID=363180890676789250

# ── MinIO (remote S3-compatible) ──────────────────────────────
MINIO_ENDPOINT=miniapi.orbispm.in
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=strongpassword
MINIO_BUCKET=orbispm
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=https://miniapi.orbispm.in/orbispm

# ── Meilisearch ───────────────────────────────────────────────
MEILI_MASTER_KEY=masterkey-for-dev-only

# ── SMTP (production mail provider) ──────────────────────────
# Replace with real SMTP credentials for production
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@orbispm.live
SMTP_ENABLED=true
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# ── API ───────────────────────────────────────────────────────
API_PORT=8080
API_REPLICAS=1
JWT_SECRET=orbispm-dev-jwt-secret-32chars!!
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=50

# ── Kong ──────────────────────────────────────────────────────
KONG_PROXY_PORT=8001
KONG_SSL_PORT=8443
KONG_LOG_LEVEL=info


# ── Frontend (Next.js build args) ────────────────────────────
NEXT_PUBLIC_API_URL=https://api.orbispm.in
NEXT_PUBLIC_WS_URL=wss://api.orbispm.in

# ── Email service ─────────────────────────────────────────────
EMAIL_SERVICE_API_KEY=email-service-dev-key

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false
