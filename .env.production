# ============================================================
# OrbisPM — PRODUCTION
# ============================================================
# Usage: docker compose --env-file .env.production up -d
# Or:    make up-prod
#
# Fill in all YOUR_* placeholders before deploying.
# NEVER commit this file — it is in .gitignore.
# ============================================================

COMPOSE_PROJECT_NAME=orbispm

# ── Application ───────────────────────────────────────────────
APP_ENV=production
ENV=production
APP_NAME=OrbisPM
BASE_URL=https://api.orbispm.in
FRONTEND_URL=https://orbispm.live
FRONTEND_PORT=3000
ALLOWED_ORIGINS=https://www.orbispm.in,https://orbispm.in,https://orbispm.live,https://www.orbispm.live

# ── PostgreSQL (external host, same LAN) ─────────────────────
POSTGRES_HOST=192.168.1.23
POSTGRES_PORT=5432
POSTGRES_USER=ravi_admin
POSTGRES_PASSWORD=Suraj5522
POSTGRES_DB=orbispmdev
DATABASE_URL=postgres://ravi_admin:Suraj5522@192.168.1.23:5432/orbispmdev?sslmode=disable

# ── Redis (local Docker) ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0
EMAIL_REDIS_URL=redis://redis:6379/1
# ── Zitadel (local with tunnel) ──────────────────────────────────────────
ZITADEL_DOMAIN=zitadel.orbispm.in
ZITADEL_ISSUER=https://zitadel.orbispm.in
ZITADEL_INTERNAL_URL=https://zitadel.orbispm.in

ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_EXTERNAL_DOMAIN=zitadel.orbispm.in
ZITADEL_EXTERNAL_PORT=443
ZITADEL_EXTERNAL_SECURE=true
ZITADEL_ADMIN_USER=admin@orbispm.local
ZITADEL_ADMIN_PASSWORD=Admin123!
ZITADEL_ORG_NAME=OrbisPM
ZITADEL_INSTANCE_NAME=OrbisPM
ZITADEL_MACHINE_USERNAME=backend-service
ZITADEL_MACHINE_NAME=OrbisPM Backend
ZITADEL_MACHINE_PAT_EXPIRY=2030-01-01T00:00:00Z
ZITADEL_LOG_LEVEL=info
ZITADEL_VERSION=v4.12.1

ZITADEL_SERVICE_TOKEN=D9XwpAlNpcyMPG0eUOLHzr2Zn-QnRenvfCxWkbnZ8_0_RZ-ghEcdujcUKwBN3DU77o80LkY
ZITADEL_CLIENT_ID=365137497891602949

# ── MinIO (remote S3-compatible) ──────────────────────────────
MINIO_ENDPOINT=miniapi.orbispm.in
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=strongpassword
MINIO_BUCKET=orbispm
MINIO_USE_SSL=true
MINIO_PUBLIC_URL=https://miniapi.orbispm.in/orbispm
# MinIO root credentials (needed for zitadel-service local container init only)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=strongpassword

# ── Meilisearch ───────────────────────────────────────────────
MEILI_MASTER_KEY=masterkey-for-dev-only

# ── SMTP (production mail provider) ──────────────────────────
# Replace with real SMTP credentials for production
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@orbispm.live
SMTP_ENABLED=true
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# ── API ───────────────────────────────────────────────────────
API_PORT=8080
API_REPLICAS=1
MSG_PORT=8082
JWT_SECRET=orbispm-dev-jwt-secret-32chars!!
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=50

# ── NATS ──────────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── Kong (host port 8001 maps to Kong's internal proxy port 8000) ──────────
# Reverse proxy (Caddy/Nginx) must forward traffic to localhost:8001
KONG_PROXY_PORT=8001
KONG_SSL_PORT=8443
KONG_LOG_LEVEL=info


# ── Frontend (Next.js build args) ────────────────────────────
NEXT_PUBLIC_API_URL=https://api.orbispm.in
NEXT_PUBLIC_WS_URL=wss://api.orbispm.in
NEXT_PUBLIC_APP_URL=https://orbispm.live
FRONTEND_PORT=3000

# ── Email service ─────────────────────────────────────────────
EMAIL_SERVICE_API_KEY=email-service-dev-key

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false
