# ============================================================
# OrbisPM — Unified Environment Configuration (Example)
# ============================================================
# Copy to .env and adjust values for your environment:
#   cp .env.example .env
#
# Docker Compose auto-loads .env from the project root.
# ============================================================

# ── Compose ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=orbispm

# ── Application ──────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
BASE_URL=http://localhost:8000               # Kong gateway public URL
FRONTEND_URL=http://localhost:3000           # Next.js frontend URL

# ── PostgreSQL ───────────────────────────────────────────────
# To use an external PostgreSQL (e.g. your existing Postgres 18):
#   1. Remove "docker-compose.postgres.yml" from includes in docker-compose.yml
#   2. Set POSTGRES_HOST/PORT to your external instance
#   3. Ensure the database and user exist
POSTGRES_HOST=postgres                       # Docker service name or external hostname
POSTGRES_PORT=5432                           # Connection port
POSTGRES_USER=orbispm
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=orbispm
POSTGRES_MAPPED_PORT=5432                    # Host port mapping for dev access

# ── Redis ────────────────────────────────────────────────────
# To use an external Redis: change REDIS_HOST/PORT and remove
# docker-compose.redis.yml from includes in docker-compose.yml
REDIS_HOST=redis                             # Docker service name or external hostname
REDIS_PORT=6379                              # Connection port
REDIS_MAPPED_PORT=6380                       # Host port mapping for dev access
REDIS_PASSWORD=                              # Leave empty for no auth

# ── Zitadel (Identity Provider) ─────────────────────────────
ZITADEL_MASTERKEY=MustBeExactly32Characters! # CHANGE in production
ZITADEL_MAPPED_PORT=8081                     # Host port mapping
ZITADEL_EXTERNAL_DOMAIN=localhost            # Public domain for Zitadel
ZITADEL_EXTERNAL_SECURE=false                # true if behind HTTPS
ZITADEL_ADMIN_USER=admin@orbispm.local
ZITADEL_ADMIN_PASSWORD=Admin123!             # CHANGE in production
ZITADEL_ORG_NAME=OrbisPM
ZITADEL_INSTANCE_NAME=OrbisPM
ZITADEL_MACHINE_USERNAME=backend-service
ZITADEL_MACHINE_NAME=OrbisPM Backend
ZITADEL_MACHINE_PAT_EXPIRY=2030-01-01T00:00:00Z
ZITADEL_LOG_LEVEL=info
# Generated by: python3 scripts/zitadel-setup.py
ZITADEL_SERVICE_TOKEN=
ZITADEL_CLIENT_ID=

# ── MinIO (Object Storage) ──────────────────────────────────
# To use external S3/MinIO: change MINIO_HOST and remove
# docker-compose.minio.yml from includes in docker-compose.yml
MINIO_HOST=minio                             # Docker service name or external hostname
MINIO_ROOT_USER=minioadmin                   # CHANGE in production
MINIO_ROOT_PASSWORD=minioadmin               # CHANGE in production
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=orbispm
MINIO_DRIVE_BUCKET=orbispm-drive             # private bucket for Orbis Drive (never public)
DRIVE_MAX_FILE_MB=100                        # per-file Drive upload limit
MINIO_USE_SSL=false                          # true for production S3

# ── Meilisearch ─────────────────────────────────────────────
MEILI_HOST=meilisearch
MEILI_MASTER_KEY=masterkey-for-dev-only      # CHANGE in production
MEILI_PORT=7700

# ── Mailpit (Development SMTP) ──────────────────────────────
# For production: replace with real SMTP (e.g. SES, Mailgun)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@simplifyai.id
SMTP_ENABLED=true
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── API Backend ──────────────────────────────────────────────
API_PORT=8080
API_REPLICAS=1                               # Increase for horizontal scaling
JWT_SECRET=change-this-to-a-32char-secret!!  # CHANGE in production
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=50

# ── Kong API Gateway ────────────────────────────────────────
KONG_PROXY_PORT=8000
KONG_SSL_PORT=8443
KONG_LOG_LEVEL=info

# ── NocoDB ───────────────────────────────────────────────────
NOCODB_PORT=8082

# ── Stripe (optional) ───────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false

# ── SSO / Identity Providers (Zitadel IDP IDs) ─────────────
# These are the Zitadel IDP IDs configured in your Zitadel application.
# Override these if you change or add IDPs in the Zitadel console.
GOOGLE_IDP_ID=371632718112358914
GITHUB_IDP_ID=371633241645384194

# AFFiNE (project Canvas tab) — see docker-compose.yaml `affine`, `affine-bridge`
AFFINE_DB_PASSWORD=change-me
AFFINE_ADMIN_EMAIL=affine-admin@orbispm.local
AFFINE_ADMIN_PASSWORD=change-me
# HMAC key deriving each user's AFFiNE password (generate: openssl rand -base64 32).
# Changing it locks existing AFFiNE accounts out.
AFFINE_USER_SECRET=change-me
