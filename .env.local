# ============================================================
# OrbisPM — LOCAL DEVELOPMENT
# ============================================================
# Usage: docker compose --env-file .env.local --profile local up -d
# Or:    make up
#
# All services run locally in Docker.
# NEVER commit this file — it is in .gitignore.
# ============================================================

COMPOSE_PROJECT_NAME=orbispm

# ── Application ───────────────────────────────────────────────
APP_ENV=development
ENV=development
APP_NAME=Simplify Projects
BASE_URL=http://localhost:8000
