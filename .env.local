# ============================================================
# OrbisPM — LOCAL DEVELOPMENT
# ============================================================
# Usage: docker compose --env-file .env.local --profile local up -d
# Or:    make up
#
# All services run locally in Docker.
# NEVER commit this file — it is in .gitignore.
# ============================================================

COMPOSE_PROJECT_NAME=orbispm

# ── Application ───────────────────────────────────────────────
APP_ENV=development
ENV=development
APP_NAME=OrbisPM
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── PostgreSQL (local Docker) ─────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YESVeW48YWdzHq3DYlJRG80DjMgIE
POSTGRES_DB=orbispmdev
DATABASE_URL=postgres://postgres:YESVeW48YWdzHq3DYlJRG80DjMgIE@postgres:5432/orbispmdev?sslmode=disable

# ── Redis (local Docker) ──────────────────────────────────────
REDIS_URL=redis://redis:6379/0
EMAIL_REDIS_URL=redis://redis:6379/1

# ── Zitadel (local Docker) ────────────────────────────────────
ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters
ZITADEL_EXTERNAL_DOMAIN=localhost
ZITADEL_EXTERNAL_PORT=8081
ZITADEL_EXTERNAL_SECURE=false
ZITADEL_ADMIN_USER=admin@orbispm.local
ZITADEL_ADMIN_PASSWORD=Admin123!
ZITADEL_ORG_NAME=OrbisPM
ZITADEL_INSTANCE_NAME=OrbisPM
ZITADEL_MACHINE_USERNAME=backend-service
ZITADEL_MACHINE_NAME=OrbisPM Backend
ZITADEL_MACHINE_PAT_EXPIRY=2030-01-01T00:00:00Z
ZITADEL_LOG_LEVEL=info
ZITADEL_VERSION=v4.12.1
# Backend connection to Zitadel
ZITADEL_DOMAIN=localhost
ZITADEL_ISSUER=http://localhost:8081
ZITADEL_INTERNAL_URL=http://zitadel:8080
ZITADEL_SERVICE_TOKEN=biGTGaq42dGysNk28zrxZKumHwDMxQWQm_MPE2mTM0WkJ1ptpHh-N_uBbjIST2541ZgeFOg
ZITADEL_CLIENT_ID=364620459410522121

# ── MinIO (local Docker) ──────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=orbispm
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000/orbispm

# ── Meilisearch ───────────────────────────────────────────────
MEILI_MASTER_KEY=masterkey-for-dev-only

# ── SMTP (local Mailpit) ──────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@orbispm.local
SMTP_ENABLED=true
SMTP_USE_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# ── API ───────────────────────────────────────────────────────
API_PORT=8080
API_REPLICAS=1
JWT_SECRET=orbispm-dev-jwt-secret-32chars!!
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=50

# ── Kong ──────────────────────────────────────────────────────
KONG_PROXY_PORT=8000
KONG_SSL_PORT=8443
KONG_LOG_LEVEL=info

# ── NocoDB ────────────────────────────────────────────────────
NOCODB_DB_URL=pg://postgres:5432?u=postgres&p=YESVeW48YWdzHq3DYlJRG80DjMgIE&d=orbispmdev

# ── Frontend (Next.js build args) ────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Email service ─────────────────────────────────────────────
EMAIL_SERVICE_API_KEY=email-service-dev-key

# ── Stripe (disabled in dev) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ENABLED=false

# ── NATS (local Docker) ──────────────────────────────────────
NATS_URL=nats://nats:4222

# ── Messaging Service ────────────────────────────────────────
MSG_PORT=8082
