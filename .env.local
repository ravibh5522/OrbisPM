# ── API ───────────────────────────────────────────────────────
API_PORT=8080
API_REPLICAS=1
JWT_SECRET=orbispm-dev-jwt-secret-32chars!!
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_BURST=50

# ── Kong ──────────────────────────────────────────────────────
KONG_PROXY_PORT=8000
KONG_SSL_PORT=8443
KONG_LOG_LEVEL=info

