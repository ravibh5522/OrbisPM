services:
  postgres:
    image: postgres:16-alpine
    restart: unless-stopped
    ports:
      - "5432:5432"
    environment:
      POSTGRES_USER: orbispm
      POSTGRES_PASSWORD: orbispm
      POSTGRES_DB: orbispm
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./db-init:/docker-entrypoint-initdb.d
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U orbispm"]
      interval: 5s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "6380:6379"
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

  zitadel:
    image: ghcr.io/zitadel/zitadel:v2.71.6
    restart: unless-stopped
    command: start-from-init --masterkeyFromEnv --tlsMode disabled
    ports:
      - "8081:8080"
    environment:
      ZITADEL_MASTERKEY: "MasterkeyNeedsToHave32Characters"
      ZITADEL_DATABASE_POSTGRES_HOST: postgres
      ZITADEL_DATABASE_POSTGRES_PORT: "5432"
      ZITADEL_DATABASE_POSTGRES_DATABASE: orbispm
      ZITADEL_DATABASE_POSTGRES_USER_USERNAME: orbispm
      ZITADEL_DATABASE_POSTGRES_USER_PASSWORD: orbispm
      ZITADEL_DATABASE_POSTGRES_USER_SSL_MODE: disable
      ZITADEL_DATABASE_POSTGRES_ADMIN_USERNAME: orbispm
      ZITADEL_DATABASE_POSTGRES_ADMIN_PASSWORD: orbispm
      ZITADEL_DATABASE_POSTGRES_ADMIN_SSL_MODE: disable
      ZITADEL_EXTERNALSECURE: "false"
      ZITADEL_EXTERNALPORT: "8081"
      ZITADEL_EXTERNALDOMAIN: "localhost"
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME: "admin@orbispm.local"
      ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD: "Admin123!"
      ZITADEL_FIRSTINSTANCE_ORG_NAME: "OrbisPM"
      ZITADEL_FIRSTINSTANCE_INSTANCENAME: "OrbisPM"
      ZITADEL_FIRSTINSTANCE_DEFAULTLANGUAGE: "en"
      ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_USERNAME: "backend-service"
      ZITADEL_FIRSTINSTANCE_ORG_MACHINE_MACHINE_NAME: "OrbisPM Backend"
      ZITADEL_FIRSTINSTANCE_ORG_MACHINE_PAT_EXPIRATIONDATE: "2030-01-01T00:00:00Z"
      ZITADEL_LOG_LEVEL: "info"
    depends_on:
      postgres:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080/debug/healthz || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  minio:
    image: minio/minio:latest
    restart: unless-stopped
    ports:
      - "9000:9000"
      - "9001:9001"
    environment:
      MINIO_ROOT_USER: minioadmin
      MINIO_ROOT_PASSWORD: minioadmin
    volumes:
      - miniodata:/data
    command: server /data --console-address ":9001"
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 5s
      timeout: 5s
      retries: 5

  meilisearch:
    image: getmeili/meilisearch:v1.7
    restart: unless-stopped
    ports:
      - "7700:7700"
    environment:
      MEILI_MASTER_KEY: "masterkey-for-dev-only"
      MEILI_NO_ANALYTICS: "true"
    volumes:
      - meilidata:/meili_data
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:7700/health"]
      interval: 5s
      timeout: 5s
      retries: 5

  mailpit:
    image: axllent/mailpit:latest
    restart: unless-stopped
    ports:
      - "8025:8025"
      - "1025:1025"
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:8025/api/v1/info"]
      interval: 5s
      timeout: 5s
      retries: 5

  api:
    build:
      context: ./backend
      dockerfile: Dockerfile
    restart: unless-stopped
    expose:
      - "8080"
    environment:
      PORT: "8080"
      ENV: development
      DATABASE_URL: postgres://orbispm:orbispm@postgres:5432/orbispm?sslmode=disable
      REDIS_URL: redis://redis:6379/0
      ZITADEL_DOMAIN: "localhost:8081"
      ZITADEL_ISSUER: "http://localhost:8081"
      ZITADEL_SERVICE_TOKEN: "yLuIIVIzl05t1RGZMsHt-X4tQTdt--LNlBEgtlQnFsFoQiO2a1eP83nbKYtSlDfoBxxzg7M"
      ZITADEL_CLIENT_ID: "362919913230237700"
      JWT_SECRET: "orbispm-dev-jwt-secret-32chars!!"
      MINIO_ENDPOINT: "minio:9000"
      MINIO_ACCESS_KEY: minioadmin
      MINIO_SECRET_KEY: minioadmin
      MINIO_BUCKET: orbispm
      MINIO_USE_SSL: "false"
      MINIO_PUBLIC_URL: "http://localhost:8000/storage/orbispm"
      MEILI_URL: "http://meilisearch:7700"
      MEILI_MASTER_KEY: "masterkey-for-dev-only"
      FRONTEND_URL: http://localhost:3000
      BASE_URL: http://localhost:8000
      SMTP_HOST: mailpit
      SMTP_PORT: "1025"
      SMTP_FROM: "noreply@orbispm.local"
      SMTP_ENABLED: "true"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  kong:
    image: kong/kong-gateway:3.9
    restart: unless-stopped
    ports:
      - "8000:8000"
      - "8443:8443"
    environment:
      KONG_DATABASE: "off"
      KONG_DECLARATIVE_CONFIG: /kong/kong.yml
      KONG_PROXY_ACCESS_LOG: /dev/stdout
      KONG_ADMIN_ACCESS_LOG: /dev/stdout
      KONG_PROXY_ERROR_LOG: /dev/stderr
      KONG_ADMIN_ERROR_LOG: /dev/stderr
      KONG_PROXY_LISTEN: "0.0.0.0:8000, 0.0.0.0:8443 ssl"
      KONG_LOG_LEVEL: info
    volumes:
      - ./kong.yml:/kong/kong.yml:ro
    depends_on:
      - zitadel
      - api
      - nocodb

volumes:
  pgdata:
  redisdata:
  miniodata:
  meilidata:

