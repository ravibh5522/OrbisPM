    {
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 33 },
      "id": 40,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "title": "Live Error Logs (all services)",
      "targets": [
        {
          "expr": "{service=~\".+\"} |~ \"error|ERROR|panic|fatal\"",
          "legendFormat": ""
        }
      ],
      "type": "logs"
