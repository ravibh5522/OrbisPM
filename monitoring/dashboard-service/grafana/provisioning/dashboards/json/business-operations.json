      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        }
      },
      "title": "File Upload Size Distribution",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(file_upload_size_bytes_bucket[1h])) by (le))",
