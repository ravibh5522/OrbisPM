      "id": 100,
      "title": "Business Activity Summary",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "title": "Tasks Created/hr",
      "targets": [
        {
          "expr": "sum(rate(business_operations_total{entity=\"task\",action=\"create\"}[5m])) * 3600",
          "legendFormat": "tasks/hr"
        }
      ],
      "type": "stat"
    },
