      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean"]
        },
        "tooltip": { "mode": "multi" }
      },
      "title": "Cache Hit Rate",
      "targets": [
        {
          "expr": "sum(rate(cache_operations_total{operation=\"hit\"}[5m])) by (cache_name) / (sum(rate(cache_operations_total{operation=\"hit\"}[5m])) by (cache_name) + sum(rate(cache_operations_total{operation=\"miss\"}[5m])) by (cache_name))",
          "legendFormat": "{{cache_name}}"
