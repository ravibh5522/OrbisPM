# =======================================================
# OrbisPM Monitoring Stack — Environment Configuration
# =======================================================
# Copy to .env and customize values for your environment

# -------------------------------------------------------
# Environment
# -------------------------------------------------------
ENV=development
LOG_DEBUG=false

# -------------------------------------------------------
# PostgreSQL (same as main app)
# -------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=orbispm
POSTGRES_USER=orbispm
POSTGRES_PASSWORD=changeme

# -------------------------------------------------------
# Redis (same as main app)
# -------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# -------------------------------------------------------
# Grafana
# -------------------------------------------------------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme
GF_ROOT_URL=http://localhost:3001

# -------------------------------------------------------
# ClickHouse
# -------------------------------------------------------
CH_USER=monitoring
CH_PASSWORD=changeme
CH_PASSWORD_HASH=a665a45920422f9d417e4867efdc4fb8a04a1f3fff1fa07e998e86f7f7a27ae3  # sha256 of "changeme"
CLICKHOUSE_ENABLED=false

# -------------------------------------------------------
# Alerting
# -------------------------------------------------------
ALERT_EMAIL_TO=admin@orbispm.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@orbispm.local

# Slack (optional)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# PagerDuty (optional)
# PAGERDUTY_SERVICE_KEY=xxx

# Discord (optional)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx

# -------------------------------------------------------
# Zitadel (for Super Admin Auth)
# -------------------------------------------------------
ZITADEL_ISSUER=http://localhost:8085
ZITADEL_CLIENT_ID=orbispm-admin

# -------------------------------------------------------
# Retention Settings
# -------------------------------------------------------
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=10GB
LOKI_RETENTION_PERIOD=720h
TEMPO_BLOCK_RETENTION=168h
CLICKHOUSE_METRICS_TTL=90
CLICKHOUSE_LOGS_TTL=90
CLICKHOUSE_TRACES_TTL=30
